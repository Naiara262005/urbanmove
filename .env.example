# Copia este fichero a `.env` y ajusta los valores. NUNCA subas `.env` al repositorio.
# En AWS Academy (prod) no se definen credenciales aquí: los servicios usan `LabRole`.

# --- Entorno ---
URBANMOVE_ENVIRONMENT=dev
URBANMOVE_SERVICE_NAME=urbanmove
URBANMOVE_LOG_LEVEL=INFO

# --- AWS (región obligatoria en AWS Academy) ---
AWS_REGION=us-east-1

# Solo en dev: si está definido, AWSClientFactory apunta a LocalStack.
# En prod debe quedar SIN definir.
AWS_ENDPOINT_URL=http://localhost:4566

# --- Mensajería ---
# En LocalStack el id de cuenta es siempre 000000000000.
URBANMOVE_EVENTS_TOPIC_ARN=arn:aws:sns:us-east-1:000000000000:urbanmove-events

# --- Credenciales ---
# No se definen en este fichero. En dev, AWSClientFactory usa valores ficticios
# de LocalStack cuando AWS_ENDPOINT_URL está definido.
